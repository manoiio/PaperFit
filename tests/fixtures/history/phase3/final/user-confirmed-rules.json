        "right_mm": 25
      },
      "page": 20,
      "quote": "所有页面的上下左右页面边距为25mm"
    },
    "R03": {
      "name": "正文中文字体",
      "expected": "宋体",
      "page": 18,
      "quote": "正文：小四号，宋体，1.5倍行距"
    },
    "R04": {
      "name": "正文西文字体",
      "expected": "Times New Roman",
      "page": 18,
      "quote": "英文单词：字号、行距与正文相同，字体为Times New Roman",
      "demo_interpretation": "演示将西文数字一并检查；只支持ASCII和Latin字符，不推断复杂文字字体槽位。"
    },
    "R05": {
      "name": "正文普通文字字号",
      "unit": "pt",
      "expected": 14.0,
      "source": {
