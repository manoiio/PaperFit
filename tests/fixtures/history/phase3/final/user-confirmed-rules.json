      "name": "A4纸张",
      "expected": {
        "width_mm": 210,
        "height_mm": 297
      },
      "page": 20,
      "quote": "编排并打印在标准A4纸上"
    },
    "R02": {
      "name": "页面边距",
      "expected": {
        "top_mm": 25,
        "bottom_mm": 25,
