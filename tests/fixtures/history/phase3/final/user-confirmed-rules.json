        "label": "用户确认值",
        "quote": "用户在网页手动确认值，不宣称原文精确支持",
        "input_text": "正文四号，2倍行距",
        "file": null,
        "physical_page": null,
        "model": null,
        "parse_kind": null
      }
    },
    "R06": {
      "name": "正文行距",
      "unit": "multiple",
      "expected": 2,
      "source": {
        "kind": "ai_extracted",
        "label": "AI提取后用户确认",
        "quote": "2倍行距",
        "input_text": "正文四号，2倍行距",
        "file": null,
        "physical_page": null,
        "model": "deepseek-flash",
        "parse_kind": "real_api"
      }
    },
    "R07": {
      "name": "正文首行缩进",
      "expected": 2,
      "unit": "CJK characters",
      "page": 18,
      "quote": "段首行缩进2个汉字",
      "demo_interpretation": "firstLineChars=200；可判断等效点值=2×当前统一字号，不固定48pt；冲突属性不算通过。"
    }
